<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="horizontal"
    android:padding="8dp"
    android:background="@drawable/tv_focus_selector"
    android:descendantFocusability="blocksDescendants">

    <FrameLayout
        android:layout_width="220dp"
        android:layout_height="124dp">
        <io.github.gohoski.notpipe.ui.AspectRatioImageView
            android:id="@+id/video_thumbnail"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:scaleType="centerCrop"
            tools:src="@android:color/white" />
        <TextView
            android:id="@+id/duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|right"
            android:layout_margin="5dip"
            android:background="#CC000000"
            android:padding="3dip"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:visibility="gone"
            tools:visibility="visible"
            tools:text="00:00"/>
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginLeft="12dip"
        android:gravity="top">
                <TextView
            android:id="@+id/video_title"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="15sp"
            android:maxLines="3"
            android:ellipsize="end"
            tools:text="Exampletitle" />

        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dip"
            android:gravity="center_vertical">
            <ImageView
                android:id="@+id/channel_thumbnail"
                android:layout_width="32dip"
                android:layout_height="32dip"
                android:scaleType="fitCenter"
                android:layout_marginRight="8dip"
                tools:src="@android:drawable/ic_popup_sync" />
            <TextView
                android:id="@+id/channel_title"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                tools:text="Goida · 12M views" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
